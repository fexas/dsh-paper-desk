{
  "name": "dsh-paper-desk",
  "version": "1.1.0",
  "description": "A Zotero-style paper reading desk for DeepSeek Harness: projects, PDF highlights, notes and a DeepSeek co-reading chat.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check index.js && node --check host/service.js && node --check client.js"
  },
  "devDependencies": {
    "dompurify": "^3.2.4",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.65.0",
    "marked": "^18.1.2",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.5"
  },
  "license": "MIT",
  "author": {
    "name": "Zhang Hao",
    "url": "https://github.com/fexas"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fexas/dsh-paper-desk.git"
  },
  "homepage": "https://github.com/fexas/dsh-paper-desk#readme",
  "bugs": {
    "url": "https://github.com/fexas/dsh-paper-desk/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pdf",
    "paper-reader",
    "zotero",
    "annotations",
    "markdown",
    "katex",
    "research"
  ]
}
